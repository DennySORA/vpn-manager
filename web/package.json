{
  "name": "vpn-manager-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "VPN Manager 桌面工作台（React／Vite／Tailwind CSS；繁體中文、英文、日文）。由 vpnd controller 嵌入提供。",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "node node_modules/typescript-native/bin/tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 && depcruise src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.72.0",
    "motion": "14.13.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
